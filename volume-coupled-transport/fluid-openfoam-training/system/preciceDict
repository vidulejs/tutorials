FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      preciceDict;
}

preciceConfig "../precice-config.xml";

participant Fluid;

modules (GENERAL);

interfaces
{
  Interface1
  {
    mesh              Fluid-Mesh;
    patches           ();
    cellSets          ();
    locations         volumeCenters;
    
    readData
    {
    };
    
    writeData
    {
      Velocity
      {
        solver_name U;
      };
      Pressure
      {
        solver_name p;
      };
    };
  };

  Interface2
  {
    mesh              Feedback-Mesh;
    patches           ();
    cellSets          ();
    locations         volumeCenters;
    
    readData
    {
      Velocity
      {
        solver_name U;
      };
      Pressure
      {
        solver_name p;
      };
    };

    writeData
    {
    };
  }
};
