<?xml version="1.0" encoding="UTF-8" ?>
<precice-configuration>
  <log>
    <sink
      filter="%Severity% > debug and %Rank% = 0"
      format="---[precice] %ColorizedSeverity% %Message%"
      enabled="true" />
  </log>

  <data:vector name="VelocityComputed" />
  <data:scalar name="PressureComputed" />
  <data:vector name="VelocityFeedback" />
  <data:scalar name="PressureFeedback" />

  <mesh name="Fluid-Mesh" dimensions="2">
    <use-data name="VelocityComputed" />
    <use-data name="PressureComputed" />
    <use-data name="VelocityFeedback" />
    <use-data name="PressureFeedback" />
  </mesh>

  <mesh name="Feedback-Mesh" dimensions="2">
    <use-data name="VelocityComputed" />
    <use-data name="PressureComputed" />
    <use-data name="VelocityFeedback" />
    <use-data name="PressureFeedback" />
  </mesh>

  <participant name="Fluid">
    <provide-mesh name="Fluid-Mesh" />
    <receive-mesh name="Feedback-Mesh" from="Feedback" />
    
    <write-data name="VelocityComputed" mesh="Fluid-Mesh" />
    <write-data name="PressureComputed" mesh="Fluid-Mesh" />
    
    <read-data name="VelocityFeedback" mesh="Fluid-Mesh" />
    <read-data name="PressureFeedback" mesh="Fluid-Mesh" />

    <mapping:nearest-neighbor 
      direction="read" 
      from="Feedback-Mesh" 
      to="Fluid-Mesh" 
      constraint="consistent" />
  </participant>

  <participant name="Feedback">
    <provide-mesh name="Feedback-Mesh" />
    <receive-mesh name="Fluid-Mesh" from="Fluid" />

    <read-data name="VelocityComputed" mesh="Feedback-Mesh" />
    <read-data name="PressureComputed" mesh="Feedback-Mesh" />
    
    <write-data name="VelocityFeedback" mesh="Feedback-Mesh" />
    <write-data name="PressureFeedback" mesh="Feedback-Mesh" />

    <mapping:nearest-neighbor 
      direction="read" 
      from="Fluid-Mesh" 
      to="Feedback-Mesh" 
      constraint="consistent" />
  </participant>

  <m2n:sockets acceptor="Feedback" connector="Fluid" exchange-directory=".." />

  <coupling-scheme:serial-explicit>
    <time-window-size value="0.005" />
    <max-time value="10.0" />
    <participants first="Fluid" second="Feedback" />
    
    <exchange data="VelocityComputed" mesh="Fluid-Mesh" from="Fluid" to="Feedback" />
    <exchange data="PressureComputed" mesh="Fluid-Mesh" from="Fluid" to="Feedback" />

    <exchange data="VelocityFeedback" mesh="Feedback-Mesh" from="Feedback" to="Fluid" />
    <exchange data="PressureFeedback" mesh="Feedback-Mesh" from="Feedback" to="Fluid" />
  </coupling-scheme:serial-explicit>
</precice-configuration>