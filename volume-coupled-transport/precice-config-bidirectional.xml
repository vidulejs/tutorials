<?xml version="1.0" encoding="UTF-8" ?>
<precice-configuration>
  <log>
    <sink
      filter="%Severity% > debug and %Rank% = 0"
      format="---[precice] %ColorizedSeverity% %Message%"
      enabled="true" />
  </log>

  <data:vector name="Velocity" />
  <data:scalar name="Pressure" />

  <mesh name="Fluid-Mesh" dimensions="2">
    <use-data name="Velocity" />
    <use-data name="Pressure" />
  </mesh>

  <mesh name="Feedback-Mesh" dimensions="2">
    <use-data name="Velocity" />
    <use-data name="Pressure" />
  </mesh>

  <participant name="Fluid">
    <provide-mesh name="Fluid-Mesh" />
    <receive-mesh name="Feedback-Mesh" from="Feedback" />
    <write-data name="Velocity" mesh="Fluid-Mesh" />
    <write-data name="Pressure" mesh="Fluid-Mesh" />

    <read-data name="Velocity" mesh="Feedback-Mesh" />
    <read-data name="Pressure" mesh="Feedback-Mesh" />
  </participant>

  <participant name="Feedback">
    <provide-mesh name="Feedback-Mesh" />
    <receive-mesh name="Fluid-Mesh" from="Fluid" />
    <read-data name="Velocity" mesh="Fluid-Mesh" />
    <read-data name="Pressure" mesh="Fluid-Mesh" />

    <write-data name="Velocity" mesh="Feedback-Mesh" />
    <write-data name="Pressure" mesh="Feedback-Mesh" />
  </participant>

  <m2n:sockets acceptor="Feedback" connector="Fluid" exchange-directory=".." />

  <coupling-scheme:serial-explicit>
    <time-window-size value="0.005" />
    <max-time value="10.0" />
    <participants first="Fluid" second="Feedback" />
    
    <exchange data="Velocity" mesh="Fluid-Mesh" from="Fluid" to="Feedback" />
    <exchange data="Pressure" mesh="Fluid-Mesh" from="Fluid" to="Feedback" />

    <exchange data="Velocity" mesh="Feedback-Mesh" from="Feedback" to="Fluid" />
    <exchange data="Pressure" mesh="Feedback-Mesh" from="Feedback" to="Fluid" />

  </coupling-scheme:serial-explicit>
</precice-configuration>